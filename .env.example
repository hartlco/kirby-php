# Absolute path to the existing site, including index.php, kirby/, site/,
# content/, vendor/ and assets/. The directory must already exist.
KIRBY_ROOT=/srv/www/hartl.co

# Use the numeric owner of the site's files: id -u and id -g.
PUID=1000
PGID=1000

# Only published on the host's loopback interface.
KIRBY_PORT=8080
PHP_THREADS=4

# Optional: use the rolling PHP 8.3 tag instead of the pinned release.
# KIRBY_IMAGE=ghcr.io/hartlco/kirby-php:8.3
